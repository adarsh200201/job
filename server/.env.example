# Backend API Environment Variables

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/jobdb?retryWrites=true&w=majority

# JWT Secret Key
# Generate a secure random string (e.g., use: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
# Render will set this automatically, but you can specify a default
PORT=4000

# Client Origin (Frontend URL)
# For development: http://localhost:3000
# For production: https://your-netlify-site.netlify.app
CLIENT_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
