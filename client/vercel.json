{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nextjobpost-backend.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://nextjobpost-backend.onrender.com/sitemap.xml"
    },
    {
      "source": "/((?!ads\\.txt|robots\\.txt|favicon\\.png|googlebc759ed7720b94f2\\.html|logo.*\\.png|logo\\.webp|app_mockup.*|assets/|sw\\.js|manifest\\.webmanifest|workbox-.*\\.js|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
