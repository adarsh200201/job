{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nextjobpost-backend-bblz.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://nextjobpost-backend-bblz.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:slug.xml",
      "destination": "https://nextjobpost-backend-bblz.onrender.com/sitemap-:slug.xml"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(googlebot|adsbot|adidxbot|bingbot|google-co-op|mediapartners-google|adsense|crawler|facebookexternalhit|twitterbot|linkedinbot|baiduspider|yandex).*"
        }
      ],
      "destination": "https://nextjobpost-backend-bblz.onrender.com/bot-render/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

