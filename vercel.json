{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://nextjobpost-backend.onrender.com/api/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "https://nextjobpost-backend.onrender.com/sitemap.xml"
    },
    {
      "src": "/((?!ads\\.txt|robots\\.txt|favicon\\.png|googlebc759ed7720b94f2\\.html|logo.*\\.png|logo\\.webp|app_mockup.*|assets/|sw\\.js|manifest\\.webmanifest|workbox-.*\\.js|sitemap\\.xml).*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
